# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# This file IS loaded automatically when the bot starts (no extra tool needed).
# Variables already set in your shell take priority over values here, so
# `DRY_RUN=false python main.py` still overrides the file for one run.

# --- Binance ---------------------------------------------------------------
# LEAVE THESE BLANK for paper trading. Paper mode only touches public endpoints
# (klines, ticker prices), which need no authentication — so you can run
# against live markets without attaching your account at all.
#
# Required only when DRY_RUN=false. On that production key, in the Binance API
# management screen:
#   ENABLE  "Enable Spot & Margin Trading"
#   DISABLE "Enable Withdrawals"      <- non-negotiable
#   DISABLE "Enable Futures"
#   RESTRICT access to your server's IP
BINANCE_API_KEY=
BINANCE_API_SECRET=

# The two switches are independent, giving three modes:
#
#   TESTNET=true  DRY_RUN=true   fake book, simulated fills   (plumbing check)
#   TESTNET=false DRY_RUN=true   REAL book, simulated fills   <- paper trading
#   TESTNET=false DRY_RUN=false  REAL book, REAL money
#
# Testnet order books are thin and unrealistic, so paper trading against the
# live book is the honest test. That is the middle row.
BINANCE_TESTNET=true
DRY_RUN=true

# Simulated starting balance for paper mode, in the quote asset. Ignored when
# DRY_RUN=false. Set this to what you would actually deploy — sizing is a
# percentage of equity, so testing on 100k and trading 1k tells you nothing
# useful about the position sizes you will really see.
PAPER_EQUITY=10000

# --- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# --- Market scope ----------------------------------------------------------
# 1h is the recommended default: four times fewer Claude calls (~$18/month
# instead of ~$72 for decisions), and fewer, more considered decisions with
# less reaction to noise. Stops and targets are NOT affected by this choice —
# they are watched every POLL_SECONDS regardless, so protection is ~30s
# whichever interval you pick. Use 15m only if you specifically want the bot
# reacting to faster structure.
CANDLE_INTERVAL=1h
CANDLES_PER_SYMBOL=120
# Leave blank to let Claude scan the liquid market (recommended while paper
# trading — trades accumulate faster, so you learn whether there is an edge
# sooner, and analyze.py breaks results down per symbol). To pin the bot to
# one coin: SYMBOL_ALLOWLIST=BTCUSDT  (comma-separate for several)
SYMBOL_ALLOWLIST=
UNIVERSE_SIZE=12
MIN_QUOTE_VOLUME=20000000

# --- Risk ------------------------------------------------------------------
# These three are coupled: notional = RISK_PER_TRADE / stop_distance.
# Raising RISK_PER_TRADE without raising MAX_POSITION_PCT means the notional
# cap silently binds on every trade. See the comments in config.py.
RISK_PER_TRADE=0.005
MAX_POSITION_PCT=0.30
MAX_DAILY_LOSS_PCT=0.03
MAX_CONCURRENT_POSITIONS=3
MIN_REWARD_RISK=1.2
MAX_STOP_DISTANCE_PCT=0.08
MIN_CONFIDENCE=0.6

# --- Runtime ---------------------------------------------------------------
POLL_SECONDS=30
JOURNAL_PATH=journal.jsonl
STATE_PATH=state.json

# --- Learning from mistakes ------------------------------------------------
# After each closed trade the bot reviews it and records a lesson when there
# is one. Lessons feed back into later decisions. A few calls a day.
ENABLE_REVIEW=true
LESSONS_PATH=lessons.json
MAX_LESSONS=25

# --- Telegram notifications ------------------------------------------------
# Phone alerts on: position opened, position closed (with P&L), daily kill
# switch tripped, bot start, and bot stopping with positions still open.
# Leave blank to disable. Setup (~2 min):
#   1. Message @BotFather in Telegram, send /newbot -> it gives you a token.
#   2. Send your new bot any message (it cannot message you first).
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy the
#      number at "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- News and catalysts ----------------------------------------------------
# Claude searches the web for a market brief on a slow cadence. Deliberately
# hourly, not per-bar: headlines change on the scale of hours, and refetching
# every 15m would multiply cost for the same information.
ENABLE_NEWS=true
NEWS_REFRESH_SECONDS=3600

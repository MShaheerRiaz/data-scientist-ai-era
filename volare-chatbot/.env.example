# ---------------------------------------------------------------------------
# Every one of these belongs to YOUR agency account, not the client's.
# Volare never signs up for anything and never sees a key.
# ---------------------------------------------------------------------------

# Required — openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-...

# Optional. Any model on your OpenRouter account. Cheaper model = cheaper chats.
# e.g. anthropic/claude-sonnet-4.5 | openai/gpt-4.1-mini | google/gemini-2.5-flash
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Required — resend.com. Free tier covers 3,000 emails/month.
RESEND_API_KEY=re_...
# Verified sending domain on your Resend account.
LEAD_EMAIL_FROM=Volare Assistant <leads@yourdomain.com>
# Where leads land. Comma-separated for multiple recipients.
LEAD_EMAIL_TO=shamus@volare.ai

# Required in production — comma-separated, no trailing slash.
# Include your Framer preview URL AND the live domain.
# e.g. https://volare.framer.website,https://volare.ai,https://www.volare.ai
ALLOWED_ORIGINS=https://volare.ai,https://www.volare.ai

# Optional — attribution shown on your OpenRouter dashboard.
SITE_URL=https://volare.ai

# Optional — WhatsApp alerts via Twilio. All four must be set or WhatsApp is skipped.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=+14155238886
# WHATSAPP_TO=+15302089382
